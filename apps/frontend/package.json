{
  "name": "typeandlearn-frontend",
  "version": "0.1.0",
  "description": "SolidJS frontend for TypeAndLearn.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "serve": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "solid-devtools": "^0.34.3",
    "typescript": "^5.7.2",
    "vite": "^7.1.4",
    "vite-plugin-solid": "^2.11.8"
  },
  "dependencies": {
    "@solidjs/router": "^0.16.1",
    "@tailwindcss/forms": "^0.5.11",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.15",
    "solid-js": "^1.9.5",
    "tailwindcss": "^3.4.19"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
