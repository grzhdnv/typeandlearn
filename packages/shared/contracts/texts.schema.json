{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TypeAndLearn Text API Contract",
  "type": "object",
  "definitions": {
    "sentence": {
      "type": "object",
      "required": ["index", "text", "translation", "translation_hints"],
      "properties": {
        "index": { "type": "integer" },
        "text": { "type": "string" },
        "translation": { "type": "string" },
        "translation_hints": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "paragraph": {
      "type": "object",
      "required": ["index", "sentences"],
      "properties": {
        "index": { "type": "integer" },
        "sentences": {
          "type": "array",
          "items": { "$ref": "#/definitions/sentence" }
        }
      },
      "additionalProperties": false
    },
    "practiceSentence": {
      "type": "object",
      "required": ["index", "sentence", "translation", "translation_hints"],
      "properties": {
        "index": { "type": "integer" },
        "sentence": { "type": "string" },
        "translation": { "type": "string" },
        "translation_hints": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "textData": {
      "type": "object",
      "required": ["title", "original_paragraphs", "practice_sentences"],
      "properties": {
        "title": { "type": "string" },
        "original_paragraphs": {
          "type": "array",
          "items": { "$ref": "#/definitions/paragraph" }
        },
        "practice_sentences": {
          "type": "array",
          "items": { "$ref": "#/definitions/practiceSentence" }
        }
      },
      "additionalProperties": false
    }
  }
}
