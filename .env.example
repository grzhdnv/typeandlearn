# Optional DeepSeek provider; used as fallback when Groq is configured.
DEEPSEEK_API_KEY=

# Optional Groq provider; primary by default. Original-text practice needs no key.
GROQ_API_KEY=

# Optional: omit to use apps/backend/data/db.sqlite.
DATABASE_URL=

# Groq free tier primary; DeepSeek non-thinking fallback. [] disables fallback.
MODEL_NAME=groq:openai/gpt-oss-120b
STRUCTURED_MODEL_NAME=groq:openai/gpt-oss-120b
FALLBACK_MODELS=["deepseek:deepseek-flash"]
# Optional evaluated free step (JSON mode, low mandatory reasoning):
# FALLBACK_MODELS=["openrouter:minimax/minimax-m3.1-flash:free","deepseek:deepseek-flash"]
# MiniMax permits input/output use for service improvement; review its terms
# before enabling this chain for user-provided learning material.

# Shared by API and workers using the same database. 20% headroom below the
# account screenshot's 30 RPM / 1,000 RPD / 8,000 TPM / 200,000 TPD.
GROQ_RPM=24
GROQ_RPD=800
GROQ_TPM=6400
GROQ_TPD=160000
GROQ_MAX_WAIT_SECONDS=10

# Approved paid fallback ceilings, in USD; UTC calendar day/month. Zero disables
# paid requests. In-flight and unknown-billing requests reserve capacity too.
DEEPSEEK_DAILY_USD=0.50
DEEPSEEK_MONTHLY_USD=5
# Conservative peak estimates per million tokens; update if provider prices change.
DEEPSEEK_INPUT_USD_PER_MTOK=0.30
DEEPSEEK_CACHED_INPUT_USD_PER_MTOK=0.006
DEEPSEEK_OUTPUT_USD_PER_MTOK=1.20
LLM_MAX_OUTPUT_TOKENS=2048
# Five fully hinted exercises need more room than a single translation.
LLM_PRACTICE_MAX_OUTPUT_TOKENS=4096
LLM_MAX_REQUEST_BYTES=32000
DAILY_TOKEN_LIMIT=50000
PROMPT_VERSION=v3-validated-hints

# Opt-in experimental OpenRouter adapter; defaults above remain unchanged.
# Use explicit openrouter:<vendor>/<model>:free IDs with structured-output support.
# Public catalog prices are checked before every inference; provider fallback is off.
OPENROUTER_API_KEY=
# Application headroom below the unfunded free tier (20 RPM / 50 RPD).
OPENROUTER_RPM=16
OPENROUTER_RPD=40
OPENROUTER_MAX_WAIT_SECONDS=10
